        {
          "name": "Create Breed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"speciesId\": \"{{speciesId}}\",\n  \"name\": \"Beetal\",\n  \"description\": \"High yield Punjab goat breed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/breeds",
