        {
          "name": "Get Breeds by Species",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/breeds?speciesId={{speciesId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "breeds"
              ],
              "query": [
                {
                  "key": "speciesId",
                  "value": "{{speciesId}}"
                }
              ]
            }
          }
        }
      ]
    },
